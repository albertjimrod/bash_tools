  "potencial_weights": {
    "_doc": "potencial = w_evidencia*evidencia + w_escalabilidad*escalabilidad + w_saturacion*saturacion + w_inversion*inversion, cada subfactor normalizado 0-1 antes de aplicar el peso (evidencia y escalabilidad: más alto mejor; saturacion e inversion llevan peso negativo, más alto = penaliza más). El resultado se reescala a 0-100 usando el rango [min, max] alcanzable con estos pesos. Edita los números para cambiar el énfasis — no hace falta tocar código.",
    "evidencia": 0.35,
    "escalabilidad": 0.35,
    "saturacion": -0.15,
    "inversion": -0.15
  },
  "baja_varianza": {
    "_doc": "Campos que el dashboard NO debe usar como eje de comparación/combinación porque casi todos los vídeos comparten el mismo valor (no discriminan). Revisado sobre los 43 métodos ya extraídos: tipo_ingreso=pasivo en 38/43 (88%); sesgo_supervivencia.presente=true en 42/43 (98%).",
    "campos": [
      "tipo_ingreso",
      "sesgo_supervivencia"
    ]
  }

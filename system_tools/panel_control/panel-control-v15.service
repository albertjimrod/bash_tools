# Unidad del panel en V15. deploy-v15.sh la copia desde R7 a
# ~/.config/systemd/user/panel-control.service: NO editarla en V15, se
# sobrescribe. Ver DOS-MAQUINAS.md.
[Unit]
Description=Panel de control local (copia desplegada desde R7)
After=network.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 -I %h/.local/share/panel-control/panel_server.py
# Dirección, puerto y clientes permitidos de ESTA máquina. Viven fuera del
# repo (que es público); plantilla en panel-control.env.example.
EnvironmentFile=%h/.config/panel-control/env
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target

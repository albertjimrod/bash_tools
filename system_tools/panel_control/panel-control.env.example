# Plantilla de ~/.config/panel-control/env en V15 (la lee panel-control-v15.service).
# El fichero real NO se versiona: lleva IPs de tu red y este repo es público.
#
#   mkdir -p ~/.config/panel-control
#   cp panel-control.env.example ~/.config/panel-control/env   # y edita las IPs

# Escuchar en todas las interfaces (necesario para entrar desde otra máquina).
# El acceso real lo limitan PANEL_ALLOW y el firewall (UFW).
PANEL_HOST=0.0.0.0
PANEL_PORT=8990

# Quién más puede abrir el panel, además de la propia máquina: IPs o redes
# CIDR separadas por comas. Pon la IP de casa de R7 y su IP de Tailscale
# (fija: sirve aunque el router cambie la de casa, y fuera de casa).
PANEL_ALLOW=192.168.1.XX,100.X.X.X

# Sección "Conexión con R7": nombre de la otra máquina en Tailscale y URL de
# su Ollama a través de ollama-tunnel-r7.service. Sin ellas no hay sección.
PANEL_PEER=r7
PANEL_PEER_OLLAMA=http://127.0.0.1:11434
